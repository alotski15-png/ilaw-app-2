import { X, Copy, Check } from 'lucide-react';
import { useState, useCallback } from 'react';

const INSTRUCTIONS = {
  gemini: {
    title: 'How to get a Google Gemini API Key',
    steps: [
      'Go to aistudio.google.com/apikey.',
      'Log in with your Google account.',
      'Click the "Create API key" button in a new project.',
      'Copy the generated key and paste it into the input field on the IlawCraft page.',
    ],
    url: 'https://aistudio.google.com/apikey',
  },
  cerebras: {
    title: 'How to get a Cerebras API Key',
    steps: [
      'Go to cloud.cerebras.ai.',
      'Sign up for a new account or log in if you have one.',
      'Navigate to the "API Keys" section from the left-hand menu.',
      'Click the "Create API Key" button.',
      'Give your key a name, then click "Create".',
      'Copy the displayed key and paste it into the Cerebras input field on the IlawCraft page.',
    ],
    url: 'https://cloud.cerebras.ai',
  },
  openai: {
    title: 'How to get an OpenAI API Key',
    steps: [
      'Go to platform.openai.com/api-keys.',
      'Sign up for a new account or log in.',
      'Click the "Create new secret key" button.',
      'Give your key a name, then click "Create secret key".',
      'Copy the key (it starts with "sk-...") and paste it into the OpenAI input field on the IlawCraft page.',
    ],
    url: 'https://platform.openai.com/api-keys',
  },
};

export default function ApiKeyInstructionsModal({ provider, onClose }) {
  const [isCopied, setIsCopied] = useState(false);
  const providerInfo = INSTRUCTIONS[provider];

  const handleCopyClick = useCallback(() => {
    if (providerInfo && typeof window !== 'undefined') {
      navigator.clipboard.writeText(providerInfo.url).then(() => {
        setIsCopied(true);
        setTimeout(() => setIsCopied(false), 2000); // Reset after 2 seconds
      });
    }
  }, [providerInfo]);

  if (!providerInfo) return null;

  return (
    <div 
      className="fixed inset-0 z-[60] flex items-center justify-center bg-black/70 backdrop-blur-sm p-4 animate-in fade-in duration-200"
      onClick={onClose}
    >
      <div 
        className="bg-slate-800 border border-slate-700 rounded-2xl p-6 sm:p-8 max-w-lg w-full shadow-2xl space-y-5 text-slate-200 relative animate-in fade-in zoom-in-95 duration-300"
        onClick={(e) => e.stopPropagation()} // Prevent closing when clicking inside
      >
        <button
          onClick={onClose}
          className="absolute top-4 right-4 text-slate-400 hover:text-white transition-colors"
          aria-label="Close instructions"
        >
          <X className="w-6 h-6" />
        </button>
        
        <h2 className="text-xl sm:text-2xl font-bold text-white pr-8">{providerInfo.title}</h2>

        <ol className="list-decimal list-inside space-y-3 text-slate-300 text-sm sm:text-base leading-relaxed">
          {providerInfo.steps.map((step, index) => (
            <li key={index} className="pl-2">{step}</li>
          ))}
        </ol>

        <div className="border-t border-slate-700 pt-5 flex flex-col sm:flex-row gap-3">
          <a
            href={providerInfo.url}
            target="_blank"
            rel="noopener noreferrer"
            className="inline-flex items-center justify-center w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-5 rounded-xl transition shadow-lg text-sm"
          >
            Go to {new URL(providerInfo.url).hostname} &rarr;
          </a>
          <button
            onClick={handleCopyClick}
            className="inline-flex items-center justify-center w-full sm:w-auto bg-slate-700 hover:bg-slate-600 text-slate-200 font-bold py-3 px-5 rounded-xl transition text-sm"
          >
            {isCopied ? (
              <>
                <Check className="w-4 h-4 mr-2" />
                Copied!
              </>
            ) : (
              <>
                <Copy className="w-4 h-4 mr-2" />
                Copy URL
              </>
            )}
          </button>
        </div>
      </div>
    </div>
  );
}